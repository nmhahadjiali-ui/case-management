# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used for administrator user management and the seed script.
# Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used in password-reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IANA time zone used for "today", the header clock and the calendar
NEXT_PUBLIC_APP_TIMEZONE=Asia/Manila
